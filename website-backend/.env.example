PORT=3002
NODE_ENV=production
# Required when NODE_ENV=production; the server exits on startup if missing or DB unreachable.
DATABASE_URL=postgresql://user:password@localhost/database
WEBSITE_ADMIN_EMAIL=info@ultimaitech.com
WEBSITE_ADMIN_PASSWORD=change-this-password
WEBSITE_ADMIN_JWT_SECRET=change-this-secret
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://ultimaitech.com
PUBLIC_UPLOAD_BASE=/api/uploads
# Path to web root (contains index.html). Used for server-side meta injection. Production: /var/www/ultimaitech/html
# HTML_ROOT=/var/www/ultimaitech/html
