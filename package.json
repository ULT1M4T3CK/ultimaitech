{
  "name": "ultimaitech",
  "version": "1.0.0",
  "description": "UltimAItech production website monorepo (merged from EC2)",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd website-backend && npm install && cd ../web && npm install && cd ../c95 && npm install",
    "dev:backend": "cd website-backend && npm run dev",
    "dev:c95": "cd c95 && npm run dev",
    "start:backend": "cd website-backend && npm start",
    "start:web": "cd web && npm start",
    "start:c95": "cd c95 && npm start",
    "migrate:backend": "cd website-backend && npm run migrate",
    "legacy:dev": "concurrently \"npm run legacy:dev:backend\" \"npm run legacy:dev:frontend\"",
    "legacy:dev:backend": "cd legacy/portfolio-backend && npm run dev",
    "legacy:dev:frontend": "cd legacy/portfolio-frontend && npm run dev",
    "legacy:install": "cd legacy/portfolio-backend && npm install && cd ../portfolio-frontend && npm install",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "ultimaitech",
    "nextjs",
    "nodejs",
    "postgresql",
    "blog"
  ],
  "author": "UltimAItech",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
